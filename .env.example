# mini-agent reads this file from the current directory when you use the CLI.
# Variables already set in the environment win. pytest does not load this file.
# Leave everything unset to run the deterministic mock: no key and no network.

# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_TIMEOUT=60
# LLM_MAX_TOKENS=1024
# LLM_MIN_INTERVAL=0
# LLM_MAX_RETRIES=8

# Groq is the default hosted preset. LLM_API_KEY wins over GROQ_API_KEY.
# GROQ_API_KEY=

# Gemini, OpenAI-compatible preset:
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=

# OpenAI preset (gpt-4.1-mini remains on the API until 2027-01-14;
# OpenAI's listed replacement is gpt-6-luna):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=

# Web search: live (ddgs) or fixture (offline corpus).
# Mock mode defaults to fixture. Hosted mode defaults to live.
# MINI_AGENT_SEARCH=fixture
